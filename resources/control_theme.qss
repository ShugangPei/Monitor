QWidget {
    background: #eef3f9;
    color: #22364f;
    font-family: "Microsoft YaHei";
    font-size: 13px;
}

QMainWindow {
    background: #eef3f9;
}

#NavFrame {
    background: #e4ebf5;
    border: 1px solid #c5d4e8;
    border-radius: 12px;
}

#NavTitle {
    font-size: 24px;
    font-weight: 700;
    color: #2e5f93;
    padding: 6px 2px 14px 2px;
}

QPushButton#NavButton {
    background: #f7fafc;
    border: 1px solid #bed0e6;
    border-radius: 8px;
    text-align: left;
    padding: 10px 14px;
    font-size: 14px;
    color: #27415f;
}

QPushButton#NavButton:hover {
    background: #edf4fd;
}

QPushButton#NavButton:checked {
    background: #dce9f8;
    border: 1px solid #6f9fd2;
    color: #1f4f80;
    font-weight: 700;
}

#RightSidebar {
    background: #e8f0fa;
    border: 1px solid #c3d5ea;
    border-radius: 12px;
}

#SidebarTitle {
    font-size: 16px;
    font-weight: 700;
    color: #2e5f93;
}

#SidebarBox {
    background: #f8fbff;
    border: 1px solid #c7d8ea;
    border-radius: 10px;
}

#SidebarBoxTitle {
    color: #7a5a2b;
    font-size: 14px;
    font-weight: 700;
}

#SidebarKey {
    color: #5a7392;
}

#SidebarValue {
    color: #1f3855;
    font-weight: 700;
}

#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #2f5f92;
}

#Panel {
    background: #f7fbff;
    border: 1px solid #c7d7ea;
    border-radius: 12px;
}

QTableWidget {
    background: #ffffff;
    border: 1px solid #c5d5e8;
    gridline-color: #d6e2f0;
    color: #1f3855;
}

QHeaderView::section {
    background: #e6eef8;
    color: #294766;
    border: 0;
    padding: 6px;
}

QLineEdit,
QComboBox {
    background: #ffffff;
    border: 1px solid #c2d3e7;
    border-radius: 6px;
    padding: 6px;
    min-height: 22px;
    color: #1f3855;
}

QPushButton {
    background: #4f7fb0;
    border: 1px solid #3e6f9f;
    border-radius: 6px;
    padding: 7px 14px;
    color: #ffffff;
}

QPushButton:hover {
    background: #5a8ab9;
}

QProgressBar {
    border: 1px solid #bed0e6;
    border-radius: 6px;
    background: #edf3fb;
    color: #27415f;
    text-align: center;
}

QProgressBar::chunk {
    background: #3ba67f;
    border-radius: 5px;
}

#VarCard {
    background: #ffffff;
    border: 1px solid #c9d9ea;
    border-radius: 10px;
}

#VarCardName {
    color: #4c6684;
    font-size: 13px;
}

#VarCardValue {
    color: #1d3b5a;
    font-size: 14px;
    font-weight: 700;
}

#VarCardStatus {
    color: #2f8a65;
    font-weight: 700;
}

QStatusBar {
    background: #e2ebf7;
    color: #27415f;
    border-top: 1px solid #bfd1e7;
}
